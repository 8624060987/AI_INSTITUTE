# Hostinger Phusion Passenger & Apache Server Configuration for AI Institute Satana
PassengerAppRoot /home/u677383889/domains/aiinstitutesatana.in/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /
PassengerRestartDir /home/u677383889/domains/aiinstitutesatana.in/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u677383889/domains/aiinstitutesatana.in/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log
SetEnv TOKIO_WORKER_THREADS 2

# Allow Apache & LiteSpeed access to .next static assets
<DirectoryMatch "^\.next">
    Require all granted
</DirectoryMatch>

# Enable Rewrite Engine - Pass All Requests To Phusion Passenger Node Server
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Fallback missing CSS chunk requests to physical Tailwind CSS bundle
    RewriteCond %{REQUEST_URI} ^/_next/static/chunks/.*\.css$
    RewriteCond %{DOCUMENT_ROOT}/.next/static/chunks/%1 !-f
    RewriteRule ^_next/static/chunks/.*\.css$ .next/static/chunks/19rn6-ejd-o87.css [L]
</IfModule>

# MIME Types for CSS, JS, Fonts & Media Assets
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js .mjs
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType text/plain .txt
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
</IfModule>

# Security, CORS & Caching Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|png|jpg|jpeg|svg|ico|txt)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "ads.txt">
        Header set Access-Control-Allow-Origin "*"
        Header set Content-Type "text/plain; charset=UTF-8"
        Header set Cache-Control "public, max-age=86400"
    </Files>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Compression for Fast Mobile & Desktop Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
